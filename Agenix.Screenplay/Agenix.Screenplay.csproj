<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package-Specific Properties -->
    <PackageId>Agenix.Screenplay</PackageId>
    <Title>Agenix Screenplay Pattern</Title>
    <Description>Screenplay pattern implementation for the Agenix framework. Enables writing readable, maintainable, and scalable automated tests using the Actor-Task-Ability pattern for better test organization and reusability.</Description>
    <PackageTags>testing;screenplay;automation;framework;agenix;pattern;actor;task;ability;readable</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR"/>
    <PackageReference Include="NUnit"/>
    <PackageReference Include="System.Configuration.ConfigurationManager"/>
    <PackageReference Include="System.Formats.Asn1"/>
    <PackageReference Include="System.Text.Json"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agenix.Api\Agenix.Api.csproj"/>
    <ProjectReference Include="..\Agenix.Validation.NHamcrest\Agenix.Validation.NHamcrest.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Conditions\"/>
    <Folder Include="Events\"/>
    <Folder Include="Handlers\"/>
    <Folder Include="Parallel\"/>
    <Folder Include="Questions\Waits\"/>
  </ItemGroup>


</Project>
